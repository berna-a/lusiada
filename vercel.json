{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/arca/lusopedia", "destination": "/api/lusopedia" },
    { "source": "/arca/lusopedia/novo", "destination": "/index.html" },
    {
      "source": "/arca/lusopedia/:slug",
      "destination": "/api/lusopedia?slug=:slug"
    },
    { "source": "/dicionario", "destination": "/api/dicionario" },
    {
      "source": "/dicionario/:slug",
      "destination": "/api/dicionario?slug=:slug"
    },
    { "source": "/partilha", "destination": "/api/share-verso" },
    { "source": "/manifest.webmanifest", "destination": "/api/manifest" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?oslusiadas\\.pt" }],
      "destination": "/api/os-lusiadas?c=1"
    },
    {
      "source": "/canto/:n",
      "has": [{ "type": "host", "value": "(www\\.)?oslusiadas\\.pt" }],
      "destination": "/api/os-lusiadas?c=:n"
    },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
